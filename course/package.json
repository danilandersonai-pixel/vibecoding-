{
  "name": "vibe-course",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-book.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-book.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "oxlint",
    "extract:book": "node scripts/extract-book.mjs ../vibe-coding-na-praktike-2026-10.html content src/styles/figures.css",
    "build:graph": "node scripts/build-graph.mjs ../vibe-coding-na-praktike-2026-10.html content",
    "studio": "remotion studio video/index.ts",
    "render:video": "node scripts/render-video.mjs",
    "render:all": "node scripts/render-all.mjs",
    "build:mentor": "node scripts/build-mentor.mjs content/days ../mentor/days",
    "build:artifact": "npm run build && node scripts/artifact-page.mjs dist out/artifact"
  },
  "dependencies": {
    "@remotion/player": "4.0.537",
    "graphology": "0.26.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537",
    "sigma": "3.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@playwright/test": "1.56.1",
    "@remotion/cli": "4.0.537",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "d3-force": "3.0.0",
    "jsdom": "30.1.3",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
