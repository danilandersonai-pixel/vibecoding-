 "cues": [
  {
   "from": 9,
   "to": 98,
   "text": "Код от ИИ, принятый в проект, — ваш."
  },
  {
   "from": 106,
   "to": 193,
   "text": "Как его читать, чинить и проверять."
  },
  {
   "from": 232,
   "to": 323,
   "text": "Код-ревью — проверка чужих изменений."
  },
  {
   "from": 331,
   "to": 416,
   "text": "Обзор: что задето, нет ли лишнего."
  },
  {
   "from": 423,
   "to": 499,
   "text": "Интерфейс: что берёт и отдаёт."
  },
  {
   "from": 507,
   "to": 587,
   "text": "Трассировка: сценарий с данными."
  },
  {
   "from": 595,
   "to": 678,
   "text": "Края: пусто, «ничего», два клика."
  },
  {
   "from": 717,
   "to": 785,
   "text": "Обзор: задеты семь файлов."
  },
  {
   "from": 792,
   "to": 888,
   "text": "В одном — одни минусы: спросите, зачем."
  },
  {
   "from": 895,
   "to": 1004,
   "text": "Интерфейс: было — дата строкой, стало — дата."
  },
  {
   "from": 1043,
   "to": 1132,
   "text": "Ошибка — читать подряд, сверху вниз."
  },
  {
   "from": 1140,
   "to": 1206,
   "text": "Верно — четыре прохода."
  },
  {
   "from": 1245,
   "to": 1323,
   "text": "ИИ берёт то, что чаще встречал."
  },
  {
   "from": 1331,
   "to": 1433,
   "text": "Отсюда старые версии и тяжёлые библиотеки."
  },
  {
   "from": 1440,
   "to": 1519,
   "text": "Правила, версии и альтернативы."
  },
  {
   "from": 1558,
   "to": 1649,
   "text": "«Запахи» кода от ИИ: дубли, заглушки…"
  },
  {
   "from": 1657,
   "to": 1735,
   "text": "…ловят линтер и проверка типов."
  },
  {
   "from": 1743,
   "to": 1809,
   "text": "Включите их в CI заранее."
  },
  {
   "from": 1848,
   "to": 1918,
   "text": "Было: дата готовой строкой."
  },
  {
   "from": 1925,
   "to": 2012,
   "text": "Стало: частый toLocaleDateString()."
  },
  {
   "from": 2051,
   "to": 2125,
   "text": "Марина назначает на 2 ноября."
  },
  {
   "from": 2133,
   "to": 2213,
   "text": "В списке — 11/2/2026, как в США."
  },
  {
   "from": 2252,
   "to": 2320,
   "text": "Просим: даты — «2 ноября»."
  },
  {
   "from": 2327,
   "to": 2393,
   "text": "Агент задаёт язык явно."
  },
  {
   "from": 2432,
   "to": 2508,
   "text": "Верно — «2 ноября», по-русски."
  },
  {
   "from": 2547,
   "to": 2632,
   "text": "Стектрейс: сверху — что случилось."
  },
  {
   "from": 2639,
   "to": 2722,
   "text": "Ниже — ваш файл; ИИ — весь текст."
  },
  {
   "from": 2761,
   "to": 2861,
   "text": "Отладку ведёте вы: воспроизвести, сузить."
  },
  {
   "from": 2868,
   "to": 2947,
   "text": "ИИ даёт гипотезы — а не правки."
  },
  {
   "from": 2954,
   "to": 3033,
   "text": "Главное — «не исправляй сразу»."
  },
  {
   "from": 3072,
   "to": 3174,
   "text": "Сломалось за ряд коммитов? Делите пополам."
  },
  {
   "from": 3181,
   "to": 3249,
   "text": "git bisect делает это сам."
  },
  {
   "from": 3288,
   "to": 3381,
   "text": "После «Назначить» — ошибка на сервере."
  },
  {
   "from": 3389,
   "to": 3489,
   "text": "Сверху — что: null там, где ждали список."
  },
  {
   "from": 3496,
   "to": 3566,
   "text": "Ниже — ваш файл: строка 82."
  },
  {
   "from": 3605,
   "to": 3728,
   "text": "Агенту — текст ошибки и строка стектрейса, дословно."
  },
  {
   "from": 3736,
   "to": 3838,
   "text": "«Найди причину, пока ничего не исправляй»."
  },
  {
   "from": 3845,
   "to": 3941,
   "text": "Агент читает файл: причина — в запросе."
  },
  {
   "from": 3980,
   "to": 4067,
   "text": "Теперь — исправь причину в запросе."
  },
  {
   "from": 4074,
   "to": 4157,
   "text": "Было: null, стало: пустой список."
  },
  {
   "from": 4196,
   "to": 4294,
   "text": "Позже упал тест «пустая тренировка — 0»."
  },
  {
   "from": 4301,
   "to": 4384,
   "text": "git bisect делит коммиты пополам…"
  },
  {
   "from": 4391,
   "to": 4498,
   "text": "…первый плохой — «Упростить подсчёт объёма»."
  },
  {
   "from": 4537,
   "to": 4630,
   "text": "Ошибка — заглушить симптом в разметке."
  },
  {
   "from": 4638,
   "to": 4727,
   "text": "Верно — исправить сам источник null."
  },
  {
   "from": 4766,
   "to": 4862,
   "text": "Рефакторинг — порядок, поведение то же."
  },
  {
   "from": 4869,
   "to": 4958,
   "text": "Тесты, маленький шаг, тесты, коммит."
  },
  {
   "from": 4966,
   "to": 5046,
   "text": "Не прошли — откатите только шаг."
  },
  {
   "from": 5085,
   "to": 5174,
   "text": "Просим: список подходов — в SetList."
  },
  {
   "from": 5182,
   "to": 5282,
   "text": "Поведение не меняем, тесты должны пройти."
  },
  {
   "from": 5289,
   "to": 5374,
   "text": "Агент вынес список — тесты прошли."
  },
  {
   "from": 5413,
   "to": 5496,
   "text": "Обзор: обе страницы стали короче."
  },
  {
   "from": 5503,
   "to": 5588,
   "text": "SetList нет: Git за ним не следит."
  },
  {
   "from": 5627,
   "to": 5708,
   "text": "Ошибка — рефакторинг без тестов."
  },
  {
   "from": 5715,
   "to": 5798,
   "text": "Верно — тесты, потом рефакторинг."
  },
  {
   "from": 5837,
   "to": 5922,
   "text": "Тесты — от требований, не от кода."
  },
  {
   "from": 5929,
   "to": 6014,
   "text": "Упал тест — правят код, а не тест."
  },
  {
   "from": 6022,
   "to": 6088,
   "text": "Тот же тест проходит."
  },
  {
   "from": 6127,
   "to": 6210,
   "text": "Проверьте сам тест: сломайте код."
  },
  {
   "from": 6217,
   "to": 6285,
   "text": "Упал — ему можно доверять."
  },
  {
   "from": 6292,
   "to": 6373,
   "text": "Прошёл — он ничего не проверяет."
  },
  {
   "from": 6412,
   "to": 6499,
   "text": "Тест — по требованию, а не по коду."
  },
  {
   "from": 6506,
   "to": 6611,
   "text": "Три подхода по 10 раз с весом 50 кг — 1500."
  },
  {
   "from": 6618,
   "to": 6703,
   "text": "Пустая тренировка — 0. Оба прошли."
  },
  {
   "from": 6742,
   "to": 6827,
   "text": "Ломаем: умножение стало сложением."
  },
  {
   "from": 6866,
   "to": 6949,
   "text": "Тест упал: ждали 1500, вышло 180."
  },
  {
   "from": 6956,
   "to": 7028,
   "text": "Возвращаем код: git restore."
  },
  {
   "from": 7036,
   "to": 7106,
   "text": "И все десять тестов прошли."
  },
  {
   "from": 7145,
   "to": 7238,
   "text": "Сквозной тест — путь человека целиком."
  },
  {
   "from": 7246,
   "to": 7342,
   "text": "Таких тестов мало: они самые медленные."
  },
  {
   "from": 7349,
   "to": 7436,
   "text": "Весь сценарий Марины и Анны прошёл."
  },
  {
   "from": 7475,
   "to": 7562,
   "text": "Ошибка — тест, что проходит всегда."
  },
  {
   "from": 7569,
   "to": 7648,
   "text": "Верно — сломали код, тест упал."
  },
  {
   "from": 7687,
   "to": 7768,
   "text": "Код от ИИ — ваш: четыре прохода."
  },
  {
   "from": 7775,
   "to": 7849,
   "text": "Причина — раньше исправления."
  },
  {
   "from": 7857,
   "to": 7946,
   "text": "Тесты — от требований, а не от кода."
  }
