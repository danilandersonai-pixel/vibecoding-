 "cues": [
  {
   "from": 9,
   "to": 98,
   "text": "Почему 70% — быстро, а 30% — тяжело."
  },
  {
   "from": 106,
   "to": 173,
   "text": "Как с ИИ работают на деле."
  },
  {
   "from": 181,
   "to": 261,
   "text": "Шаг, дифф, откат и тест до кода."
  },
  {
   "from": 300,
   "to": 400,
   "text": "ИИ быстро доводит проект примерно до 70%."
  },
  {
   "from": 407,
   "to": 501,
   "text": "Типовое: экраны, вход по паролю, CRUD."
  },
  {
   "from": 508,
   "to": 582,
   "text": "Тут обычно и показывают демо."
  },
  {
   "from": 590,
   "to": 673,
   "text": "А 30% даются тяжелее, чем без ИИ."
  },
  {
   "from": 712,
   "to": 795,
   "text": "Над водой — то, что видно в демо."
  },
  {
   "from": 802,
   "to": 889,
   "text": "Под водой — уникальное для проекта."
  },
  {
   "from": 897,
   "to": 963,
   "text": "Это и есть последние 30%."
  },
  {
   "from": 1002,
   "to": 1078,
   "text": "Анна вводит необычный вес: −5."
  },
  {
   "from": 1086,
   "to": 1171,
   "text": "Сервер его сохраняет: «−5 кг × 8»."
  },
  {
   "from": 1210,
   "to": 1297,
   "text": "Ошибка — проверить только «60 × 8»."
  },
  {
   "from": 1304,
   "to": 1383,
   "text": "Сохранилось — «вроде работает»."
  },
  {
   "from": 1422,
   "to": 1530,
   "text": "«Вроде работает» — один сценарий из десятков."
  },
  {
   "from": 1538,
   "to": 1646,
   "text": "Верно — три: обычный, пустой и странный ввод."
  },
  {
   "from": 1654,
   "to": 1730,
   "text": "Тогда: «работает, я проверил»."
  },
  {
   "from": 1769,
   "to": 1865,
   "text": "Первый симптом — шаг вперёд, два назад."
  },
  {
   "from": 1872,
   "to": 1966,
   "text": "Парадокс знаний: опытному ИИ полезнее."
  },
  {
   "from": 1973,
   "to": 2060,
   "text": "Скрытые 30%: демо выглядит готовым."
  },
  {
   "from": 2099,
   "to": 2192,
   "text": "Анна просит агента: вес — больше нуля."
  },
  {
   "from": 2200,
   "to": 2293,
   "text": "Агент меняет проверку веса в route.ts."
  },
  {
   "from": 2301,
   "to": 2377,
   "text": "И просит проверить в браузере."
  },
  {
   "from": 2416,
   "to": 2492,
   "text": "Снова −5 и «Сохранить подход»."
  },
  {
   "from": 2500,
   "to": 2585,
   "text": "Ошибка, как и просили: шаг вперёд."
  },
  {
   "from": 2624,
   "to": 2696,
   "text": "А теперь обычный вес — 62,5."
  },
  {
   "from": 2703,
   "to": 2778,
   "text": "Запятая сломалась: шаг назад."
  },
  {
   "from": 2817,
   "to": 2902,
   "text": "Ошибка — чинить по кругу, вслепую."
  },
  {
   "from": 2909,
   "to": 2988,
   "text": "Верно — понять, что изменилось."
  },
  {
   "from": 3027,
   "to": 3131,
   "text": "Stack Overflow: около 30 000 разработчиков."
  },
  {
   "from": 3139,
   "to": 3243,
   "text": "ИИ пользуются 66%, а доверяют с оговорками."
  },
  {
   "from": 3250,
   "to": 3346,
   "text": "48% верят, только если легко проверить."
  },
  {
   "from": 3353,
   "to": 3432,
   "text": "Важные решения — лишь около 7%."
  },
  {
   "from": 3471,
   "to": 3552,
   "text": "Запуск с нуля: прототип за часы."
  },
  {
   "from": 3559,
   "to": 3627,
   "text": "Но его часто переписывают."
  },
  {
   "from": 3634,
   "to": 3732,
   "text": "Итерации: каждую правку смотрит человек."
  },
  {
   "from": 3740,
   "to": 3822,
   "text": "Выигрыш копится, долга почти нет."
  },
  {
   "from": 3861,
   "to": 3950,
   "text": "Типичный день опытного разработчика."
  },
  {
   "from": 3958,
   "to": 4051,
   "text": "Подход выбирает сам, рутину отдаёт ИИ."
  },
  {
   "from": 4059,
   "to": 4139,
   "text": "Решения и проверка — у человека."
  },
  {
   "from": 4178,
   "to": 4274,
   "text": "Ошибка — принять ответ ИИ без проверки."
  },
  {
   "from": 4281,
   "to": 4362,
   "text": "Верно — сомневаться и проверять."
  },
  {
   "from": 4401,
   "to": 4479,
   "text": "Безопасный шаг: сначала коммит."
  },
  {
   "from": 4487,
   "to": 4561,
   "text": "Маленькая просьба и проверка."
  },
  {
   "from": 4569,
   "to": 4647,
   "text": "Потом — что изменилось и зачем."
  },
  {
   "from": 4655,
   "to": 4731,
   "text": "Сошлось — коммит, нет — откат."
  },
  {
   "from": 4770,
   "to": 4855,
   "text": "Дифф: красное с минусом — удалено."
  },
  {
   "from": 4862,
   "to": 4967,
   "text": "Зелёное с плюсом — новое, серое — как было."
  },
  {
   "from": 4974,
   "to": 5059,
   "text": "По красной строке спросите: зачем?"
  },
  {
   "from": 5098,
   "to": 5196,
   "text": "Коммит «Вес больше нуля» сломал запятую."
  },
  {
   "from": 5203,
   "to": 5310,
   "text": "git revert отменяет последний коммит — HEAD."
  },
  {
   "from": 5317,
   "to": 5404,
   "text": "Отмена — тоже коммит: история цела."
  },
  {
   "from": 5443,
   "to": 5509,
   "text": "Проверяем снова: 62,5."
  },
  {
   "from": 5517,
   "to": 5597,
   "text": "Сохранилось — запятая вернулась."
  },
  {
   "from": 5636,
   "to": 5727,
   "text": "Следующий шаг Анна читает до коммита."
  },
  {
   "from": 5735,
   "to": 5820,
   "text": "Минус — удалено, плюс — добавлено."
  },
  {
   "from": 5859,
   "to": 5961,
   "text": "Ошибка — принять большую правку, не читая."
  },
  {
   "from": 5968,
   "to": 6051,
   "text": "Верно — маленький шаг и его дифф."
  },
  {
   "from": 6090,
   "to": 6171,
   "text": "Откат: история, поломка, отмена."
  },
  {
   "from": 6178,
   "to": 6254,
   "text": "И проверка: снова ли работает?"
  },
  {
   "from": 6293,
   "to": 6363,
   "text": "Лучше всего — тест до кода."
  },
  {
   "from": 6370,
   "to": 6462,
   "text": "Всё зелёное — можно двигаться дальше."
  },
  {
   "from": 6469,
   "to": 6545,
   "text": "Есть красное — принимать рано."
  },
  {
   "from": 6584,
   "to": 6680,
   "text": "Анна просит: «Сначала тест, потом код»."
  },
  {
   "from": 6687,
   "to": 6778,
   "text": "Агент пишет тест — случаи из запроса."
  },
  {
   "from": 6786,
   "to": 6873,
   "text": "И 62,5, и −5 — обе прежние поломки."
  },
  {
   "from": 6912,
   "to": 6993,
   "text": "Ошибка — «проверю потом руками»."
  },
  {
   "from": 7000,
   "to": 7087,
   "text": "Верно — тест до кода, и он красный."
  },
  {
   "from": 7095,
   "to": 7177,
   "text": "Модуля ещё нет — честный красный."
  },
  {
   "from": 7216,
   "to": 7316,
   "text": "Агент пишет lib/weight.ts — тест зелёный."
  },
  {
   "from": 7323,
   "to": 7389,
   "text": "Пять тестов из пяти."
  },
  {
   "from": 7428,
   "to": 7509,
   "text": "И руками — в конце: −5 — ошибка."
  },
  {
   "from": 7548,
   "to": 7614,
   "text": "А 62,5 сохраняется."
  },
  {
   "from": 7653,
   "to": 7761,
   "text": "ИИ сокращает путь до 70%, но не отменяет 30%."
  },
  {
   "from": 7769,
   "to": 7858,
   "text": "Проверяйте края, а не один сценарий."
  },
  {
   "from": 7866,
   "to": 7955,
   "text": "Сомневаться в ответе ИИ — нормально."
  },
  {
   "from": 7962,
   "to": 8047,
   "text": "Маленький шаг, дифф, откат и тест."
  }
 ],
