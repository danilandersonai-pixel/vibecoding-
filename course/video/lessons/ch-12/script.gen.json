 "cues": [
  {
   "from": 9,
   "to": 96,
   "text": "Своё приложение по образцу эталона."
  },
  {
   "from": 103,
   "to": 191,
   "text": "Что брать, чистая комната и сверка."
  },
  {
   "from": 198,
   "to": 283,
   "text": "Ловушки с ИИ и разбор своего кода."
  },
  {
   "from": 322,
   "to": 426,
   "text": "Обычный путь: идея, описание, код, продукт."
  },
  {
   "from": 434,
   "to": 544,
   "text": "Обратный — от эталона через разбор к описанию."
  },
  {
   "from": 552,
   "to": 634,
   "text": "Дальше — своя обычная разработка."
  },
  {
   "from": 642,
   "to": 720,
   "text": "Код эталона здесь не участвует."
  },
  {
   "from": 759,
   "to": 865,
   "text": "Идеи и поведение свободны, исполнение — нет."
  },
  {
   "from": 873,
   "to": 964,
   "text": "Вдохновение общим подходом безопасно."
  },
  {
   "from": 972,
   "to": 1069,
   "text": "Функциональный аналог — цель этой главы."
  },
  {
   "from": 1077,
   "to": 1159,
   "text": "Двойник рискован, копия — нельзя."
  },
  {
   "from": 1198,
   "to": 1300,
   "text": "Анна разобрала три эталона — без названий."
  },
  {
   "from": 1307,
   "to": 1410,
   "text": "Сценарии, экраны, данные — идеи, а не код."
  },
  {
   "from": 1417,
   "to": 1506,
   "text": "Жалобы из отзывов подскажут отличие."
  },
  {
   "from": 1545,
   "to": 1651,
   "text": "Ошибка — взять тексты, логотип и оформление."
  },
  {
   "from": 1659,
   "to": 1739,
   "text": "Верно — аналог: исполнение своё."
  },
  {
   "from": 1778,
   "to": 1869,
   "text": "Шаги 1–2: собрать и разобрать эталон."
  },
  {
   "from": 1877,
   "to": 1987,
   "text": "Шаг 3: описать своё приложение своими словами."
  },
  {
   "from": 1995,
   "to": 2099,
   "text": "Дальше стена: сквозь неё — только описание."
  },
  {
   "from": 2107,
   "to": 2189,
   "text": "Потом — собрать заново и сверить."
  },
  {
   "from": 2228,
   "to": 2317,
   "text": "Перед описанием — вопросы от агента."
  },
  {
   "from": 2325,
   "to": 2407,
   "text": "По одному на каждое решение Анны."
  },
  {
   "from": 2415,
   "to": 2504,
   "text": "Агент читает идею и разбор эталонов."
  },
  {
   "from": 2512,
   "to": 2596,
   "text": "Пять решений, которые примет Анна."
  },
  {
   "from": 2635,
   "to": 2746,
   "text": "Шаг 3: берём то, без чего продукт не работает."
  },
  {
   "from": 2753,
   "to": 2840,
   "text": "Меняем — здесь отличие от эталонов."
  },
  {
   "from": 2848,
   "to": 2954,
   "text": "Откладываем — без чего выйдет первая версия."
  },
  {
   "from": 2961,
   "to": 3038,
   "text": "Отличие — из жалоб на эталоны."
  },
  {
   "from": 3077,
   "to": 3181,
   "text": "Ошибка — дать ИИ код или скриншоты эталона."
  },
  {
   "from": 3189,
   "to": 3278,
   "text": "Верно — через стену только описание."
  },
  {
   "from": 3317,
   "to": 3400,
   "text": "Шаг 4 — новая сессия по описанию."
  },
  {
   "from": 3407,
   "to": 3507,
   "text": "Оформление тоже своё: характер — словами."
  },
  {
   "from": 3515,
   "to": 3597,
   "text": "Шаг 5 — паритет и сценарии рядом."
  },
  {
   "from": 3636,
   "to": 3744,
   "text": "Сборка у Анны — по описанию, а не по эталону."
  },
  {
   "from": 3752,
   "to": 3848,
   "text": "Запрос — по сценарию 2 из спецификации."
  },
  {
   "from": 3855,
   "to": 3936,
   "text": "Скриншотов и эталонов в нём нет."
  },
  {
   "from": 3943,
   "to": 4041,
   "text": "Агент читает спецификацию — и только её."
  },
  {
   "from": 4048,
   "to": 4133,
   "text": "И собирает экран «Мои тренировки»."
  },
  {
   "from": 4172,
   "to": 4253,
   "text": "Шаг 5 у Анны — таблица паритета."
  },
  {
   "from": 4260,
   "to": 4347,
   "text": "Сценарии: эталоны А, Б, В и «Наше»."
  },
  {
   "from": 4355,
   "to": 4452,
   "text": "Отличие: у эталонов «нет», у нас «есть»."
  },
  {
   "from": 4460,
   "to": 4530,
   "text": "«Позже» — то, что отложено."
  },
  {
   "from": 4569,
   "to": 4660,
   "text": "И где приложение отстаёт от описания."
  },
  {
   "from": 4668,
   "to": 4746,
   "text": "Пять мест — по ним надо решить."
  },
  {
   "from": 4785,
   "to": 4870,
   "text": "Ошибка — сверять на глаз, по виду."
  },
  {
   "from": 4877,
   "to": 4964,
   "text": "Верно — по сценариям, по поведению."
  },
  {
   "from": 5003,
   "to": 5096,
   "text": "Первая — «сделай так же» по скриншоту."
  },
  {
   "from": 5104,
   "to": 5193,
   "text": "Память модели вспомнит открытый код."
  },
  {
   "from": 5201,
   "to": 5285,
   "text": "Чужое имя — спор о товарном знаке."
  },
  {
   "from": 5293,
   "to": 5367,
   "text": "И копирование ошибок эталона."
  },
  {
   "from": 5406,
   "to": 5495,
   "text": "Бесконечный паритет — вечная погоня."
  },
  {
   "from": 5503,
   "to": 5594,
   "text": "Чужие данные: каталоги не выкачивают."
  },
  {
   "from": 5601,
   "to": 5673,
   "text": "Догадки ИИ проверяют руками."
  },
  {
   "from": 5712,
   "to": 5808,
   "text": "У эталонов Б и В — отметка «выполнено»."
  },
  {
   "from": 5815,
   "to": 5898,
   "text": "А в отзывах — прогресса не видно."
  },
  {
   "from": 5937,
   "to": 6024,
   "text": "Ошибка — взять галочку, не спросив."
  },
  {
   "from": 6063,
   "to": 6148,
   "text": "Верно — спросить, зачем это здесь."
  },
  {
   "from": 6187,
   "to": 6274,
   "text": "Код писал ИИ — вы разбираете чужое."
  },
  {
   "from": 6281,
   "to": 6373,
   "text": "Первый проход — карта: главные части."
  },
  {
   "from": 6380,
   "to": 6476,
   "text": "Второй — один сценарий, файл за файлом."
  },
  {
   "from": 6483,
   "to": 6551,
   "text": "Третий — описание по коду."
  },
  {
   "from": 6590,
   "to": 6681,
   "text": "Карта приложения тренера — его файлы."
  },
  {
   "from": 6689,
   "to": 6772,
   "text": "Страницы — в app, логика — в lib."
  },
  {
   "from": 6779,
   "to": 6877,
   "text": "Сценарий — «Сохранить подход» по файлам."
  },
  {
   "from": 6884,
   "to": 6980,
   "text": "Форма — page.tsx, сохраняет actions.ts."
  },
  {
   "from": 6987,
   "to": 7072,
   "text": "Вес — в weight.ts, база — в db.ts."
  },
  {
   "from": 7111,
   "to": 7215,
   "text": "Проект растёт правками — вот три последних."
  },
  {
   "from": 7223,
   "to": 7305,
   "text": "У каждой — файлы и сколько строк."
  },
  {
   "from": 7313,
   "to": 7402,
   "text": "Разросся — опишите, соберите заново."
  },
  {
   "from": 7441,
   "to": 7545,
   "text": "Ошибка — читать всё подряд с первого файла."
  },
  {
   "from": 7553,
   "to": 7633,
   "text": "Верно — три прохода, по порядку."
  },
  {
   "from": 7672,
   "to": 7750,
   "text": "Идеи берите, исполнение — своё."
  },
  {
   "from": 7758,
   "to": 7839,
   "text": "Стена — описание своими словами."
  },
  {
   "from": 7846,
   "to": 7931,
   "text": "Сборка по нему, сверка по таблице."
  },
  {
   "from": 7938,
   "to": 8008,
   "text": "А свой код — в три прохода."
  }
 ],
