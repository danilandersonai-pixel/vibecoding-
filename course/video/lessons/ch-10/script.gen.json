 "cues": [
  {
   "from": 9,
   "to": 111,
   "text": "Задача агенту, его ветка и где он буксует."
  },
  {
   "from": 118,
   "to": 203,
   "text": "Приёмка и возможности Claude Code."
  },
  {
   "from": 242,
   "to": 350,
   "text": "Фоновый агент работает в изолированной среде."
  },
  {
   "from": 358,
   "to": 451,
   "text": "Круг: план шага, действие, наблюдение."
  },
  {
   "from": 459,
   "to": 544,
   "text": "Проверки не пройдены — новый круг."
  },
  {
   "from": 551,
   "to": 647,
   "text": "Пройдены — агент оформляет пул-реквест."
  },
  {
   "from": 654,
   "to": 728,
   "text": "Решение о нём — за человеком."
  },
  {
   "from": 767,
   "to": 856,
   "text": "Наружу — пул-реквест: проверяете вы."
  },
  {
   "from": 864,
   "to": 949,
   "text": "Чужой файл — повод вернуть работу."
  },
  {
   "from": 988,
   "to": 1090,
   "text": "Пишем задачу как заявку новому сотруднику."
  },
  {
   "from": 1097,
   "to": 1185,
   "text": "Задача: личные рекорды подопечного."
  },
  {
   "from": 1192,
   "to": 1279,
   "text": "Контекст: данные и похожее решение."
  },
  {
   "from": 1318,
   "to": 1403,
   "text": "Критерии готовности — проверяемые."
  },
  {
   "from": 1410,
   "to": 1504,
   "text": "Тест: рекорд среди подходов — 62,5 кг."
  },
  {
   "from": 1511,
   "to": 1577,
   "text": "И что нельзя трогать."
  },
  {
   "from": 1616,
   "to": 1720,
   "text": "Ошибка — «сделай хорошо»: поймёт по-своему."
  },
  {
   "from": 1728,
   "to": 1810,
   "text": "Верно — критерий: тесты проходят."
  },
  {
   "from": 1849,
   "to": 1947,
   "text": "Агентов объединяют, но начните с одного."
  },
  {
   "from": 1954,
   "to": 2046,
   "text": "Оркестратор раздаёт части подагентам."
  },
  {
   "from": 2053,
   "to": 2129,
   "text": "Или цепочка: план, код, ревью."
  },
  {
   "from": 2168,
   "to": 2274,
   "text": "Задачу коммитим в main, агенту — своя ветка."
  },
  {
   "from": 2282,
   "to": 2360,
   "text": "В main — только после проверки."
  },
  {
   "from": 2399,
   "to": 2467,
   "text": "В main — коммит с задачей."
  },
  {
   "from": 2474,
   "to": 2576,
   "text": "Работа агента — в его ветке, о ней дальше."
  },
  {
   "from": 2584,
   "to": 2660,
   "text": "Так она не смешивается с main."
  },
  {
   "from": 2699,
   "to": 2788,
   "text": "Ошибка — агент правит main напрямую."
  },
  {
   "from": 2796,
   "to": 2883,
   "text": "Верно — своя ветка, решает человек."
  },
  {
   "from": 2922,
   "to": 3020,
   "text": "Агент буксует: те же шаги, та же ошибка."
  },
  {
   "from": 3027,
   "to": 3110,
   "text": "Остановите его и уточните задачу."
  },
  {
   "from": 3149,
   "to": 3253,
   "text": "Подгонка: агент ослабляет или удаляет тест."
  },
  {
   "from": 3261,
   "to": 3371,
   "text": "Prompt injection: вредная инструкция в заявке."
  },
  {
   "from": 3379,
   "to": 3476,
   "text": "Перегрузка: десять пул-реквестов в день."
  },
  {
   "from": 3484,
   "to": 3573,
   "text": "Долгие сессии и повторы стоят денег."
  },
  {
   "from": 3612,
   "to": 3688,
   "text": "Отдаём агенту задачу из файла."
  },
  {
   "from": 3696,
   "to": 3772,
   "text": "Он пишет тест по задаче и код."
  },
  {
   "from": 3780,
   "to": 3888,
   "text": "Тест не прошёл — агент правит, тест проходит."
  },
  {
   "from": 3896,
   "to": 3978,
   "text": "Ответ: «Готово». Что он поправил?"
  },
  {
   "from": 4017,
   "to": 4083,
   "text": "Тест по задаче не прошёл."
  },
  {
   "from": 4091,
   "to": 4157,
   "text": "Ждали 62,5, вышло 57,5."
  },
  {
   "from": 4196,
   "to": 4287,
   "text": "Ошибка — агент правит не код, а тест."
  },
  {
   "from": 4295,
   "to": 4371,
   "text": "Было: ждём 62,5, как в задаче."
  },
  {
   "from": 4379,
   "to": 4461,
   "text": "Стало: 57,5 — столько выдаёт код."
  },
  {
   "from": 4500,
   "to": 4591,
   "text": "Тест прошёл, но ждёт неверный рекорд."
  },
  {
   "from": 4630,
   "to": 4713,
   "text": "Подгонять тест под код — неверно."
  },
  {
   "from": 4720,
   "to": 4809,
   "text": "Верно — не трогать тест, чинить код."
  },
  {
   "from": 4848,
   "to": 4948,
   "text": "Приёмка без чтения кода: описание, файлы."
  },
  {
   "from": 4955,
   "to": 5023,
   "text": "Главный сценарий — руками."
  },
  {
   "from": 5031,
   "to": 5109,
   "text": "Проверки прошли и не ослаблены?"
  },
  {
   "from": 5148,
   "to": 5241,
   "text": "Права — ровно под задачу: код и тесты."
  },
  {
   "from": 5249,
   "to": 5336,
   "text": "Тесты без разрешения менять нельзя."
  },
  {
   "from": 5375,
   "to": 5464,
   "text": "Что принёс агент: коммиты его ветки."
  },
  {
   "from": 5472,
   "to": 5559,
   "text": "Один коммит, два файла: тест и код."
  },
  {
   "from": 5566,
   "to": 5636,
   "text": "Чужих нет. А что ждёт тест?"
  },
  {
   "from": 5675,
   "to": 5741,
   "text": "Смотрим тест: git show."
  },
  {
   "from": 5749,
   "to": 5825,
   "text": "Ждёт 57,5, в задаче — 62,5 кг."
  },
  {
   "from": 5864,
   "to": 5953,
   "text": "Ошибка — принять по ответу «Готово»."
  },
  {
   "from": 5961,
   "to": 6046,
   "text": "Не устраивает — возвращаем работу."
  },
  {
   "from": 6085,
   "to": 6185,
   "text": "Пишем: тест подогнан, в задаче — 62,5 кг."
  },
  {
   "from": 6192,
   "to": 6284,
   "text": "Агент вернул ожидание и исправил код."
  },
  {
   "from": 6291,
   "to": 6370,
   "text": "Верно: тест прошёл — по задаче."
  },
  {
   "from": 6409,
   "to": 6492,
   "text": "Теперь принимаем: ветку — в main."
  },
  {
   "from": 6499,
   "to": 6573,
   "text": "В main — тест и код рекордов."
  },
  {
   "from": 6612,
   "to": 6699,
   "text": "Навыки — инструкция для частых дел."
  },
  {
   "from": 6706,
   "to": 6813,
   "text": "Хуки — команды до или после действия агента."
  },
  {
   "from": 6820,
   "to": 6922,
   "text": "Подагенты — помощники с чистым контекстом."
  },
  {
   "from": 6930,
   "to": 7002,
   "text": "Плагины — их готовые наборы."
  },
  {
   "from": 7041,
   "to": 7122,
   "text": "По расписанию — утренняя сводка."
  },
  {
   "from": 7129,
   "to": 7231,
   "text": "Remote Control — ответы агенту с телефона."
  },
  {
   "from": 7239,
   "to": 7328,
   "text": "Claude in Chrome — в вашем браузере."
  },
  {
   "from": 7367,
   "to": 7439,
   "text": "Ошибка — включить всё сразу."
  },
  {
   "from": 7446,
   "to": 7523,
   "text": "Верно — по одной, когда нужна."
  },
  {
   "from": 7530,
   "to": 7615,
   "text": "Плагины — из известных источников."
  },
  {
   "from": 7654,
   "to": 7745,
   "text": "Задача — в четыре части, с критерием."
  },
  {
   "from": 7753,
   "to": 7819,
   "text": "Агент — в своей ветке."
  },
  {
   "from": 7826,
   "to": 7900,
   "text": "Тест могут подогнать под код."
  },
  {
   "from": 7908,
   "to": 7984,
   "text": "Принимаете — по четырём шагам."
  },
  {
   "from": 7992,
   "to": 8058,
   "text": "Возможности — по одной."
  }
 ],
 "hotspots": [
  {
