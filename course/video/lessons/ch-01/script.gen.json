 "cues": [
  {
   "from": 9,
   "to": 102,
   "text": "ИИ в работе — не выключатель, а шкала."
  },
  {
   "from": 110,
   "to": 203,
   "text": "Режимы, намерение, модели и бенчмарки."
  },
  {
   "from": 211,
   "to": 277,
   "text": "И как платить за ИИ."
  },
  {
   "from": 316,
   "to": 416,
   "text": "Режимы: кто пишет код и кто его понимает."
  },
  {
   "from": 423,
   "to": 519,
   "text": "Автодополнение: ИИ подсказывает строку."
  },
  {
   "from": 526,
   "to": 596,
   "text": "Чат: куски кода по запросу."
  },
  {
   "from": 604,
   "to": 701,
   "text": "Разработка с ИИ: вы ведёте и проверяете."
  },
  {
   "from": 709,
   "to": 794,
   "text": "Делегирование: вы проверяете итог."
  },
  {
   "from": 801,
   "to": 884,
   "text": "Вайб-кодинг: код почти не читают."
  },
  {
   "from": 923,
   "to": 1027,
   "text": "Задача: показать ошибку, если вес не число."
  },
  {
   "from": 1035,
   "to": 1139,
   "text": "Автодополнение: ИИ дописывает строки серым."
  },
  {
   "from": 1146,
   "to": 1225,
   "text": "Приняли — и строки стали кодом."
  },
  {
   "from": 1264,
   "to": 1355,
   "text": "Чат: просите словами — получаете код."
  },
  {
   "from": 1363,
   "to": 1439,
   "text": "Просим форму с проверкой веса."
  },
  {
   "from": 1447,
   "to": 1521,
   "text": "Код переносите в проект сами."
  },
  {
   "from": 1560,
   "to": 1664,
   "text": "Разработка с ИИ: агенту — небольшую задачу."
  },
  {
   "from": 1672,
   "to": 1769,
   "text": "Одна порция: показать ошибку под формой."
  },
  {
   "from": 1777,
   "to": 1870,
   "text": "Accept edits: правки агент вносит сам."
  },
  {
   "from": 1878,
   "to": 1975,
   "text": "Агент читает route.ts и правит страницу."
  },
  {
   "from": 1983,
   "to": 2064,
   "text": "А вы читаете дифф каждой правки."
  },
  {
   "from": 2103,
   "to": 2199,
   "text": "Делегирование: задачу целиком — агенту."
  },
  {
   "from": 2206,
   "to": 2297,
   "text": "Вы смотрите итог: изменения в файлах."
  },
  {
   "from": 2336,
   "to": 2438,
   "text": "Ошибка — вайб-кодить вход и права доступа."
  },
  {
   "from": 2445,
   "to": 2541,
   "text": "Демо работает — это иллюзия готовности."
  },
  {
   "from": 2549,
   "to": 2659,
   "text": "Верно: чем дороже промах, тем больше контроля."
  },
  {
   "from": 2667,
   "to": 2743,
   "text": "А вайб-кодинг — для прототипа."
  },
  {
   "from": 2782,
   "to": 2871,
   "text": "Чего вы не сказали, ИИ достроит сам."
  },
  {
   "from": 2879,
   "to": 2955,
   "text": "Самым частым, а не безопасным."
  },
  {
   "from": 2962,
   "to": 3039,
   "text": "Поэтому передавайте намерение."
  },
  {
   "from": 3046,
   "to": 3123,
   "text": "Минута на запрос экономит час."
  },
  {
   "from": 3162,
   "to": 3268,
   "text": "Намерение в деле: просим агента о CLAUDE.md."
  },
  {
   "from": 3276,
   "to": 3352,
   "text": "Цель — кратко из docs/idea.md."
  },
  {
   "from": 3360,
   "to": 3449,
   "text": "Стек — чем и на чём собираем проект."
  },
  {
   "from": 3456,
   "to": 3560,
   "text": "И рамки: раздел «Нельзя» с тремя запретами."
  },
  {
   "from": 3568,
   "to": 3668,
   "text": "Файл готов — агент спрашивает: коммитить?"
  },
  {
   "from": 3707,
   "to": 3779,
   "text": "Вот он, настоящий CLAUDE.md."
  },
  {
   "from": 3786,
   "to": 3884,
   "text": "Агент читает его в начале каждой сессии."
  },
  {
   "from": 3892,
   "to": 3966,
   "text": "Цель — что строим и для кого."
  },
  {
   "from": 4005,
   "to": 4094,
   "text": "«Нельзя»: ключи, тесты и схема базы."
  },
  {
   "from": 4133,
   "to": 4216,
   "text": "Ошибка — «Сделай вход» без рамок."
  },
  {
   "from": 4223,
   "to": 4302,
   "text": "Верно — цель, рамки и «готово»."
  },
  {
   "from": 4341,
   "to": 4449,
   "text": "Opus, Sol, Argon — бренды. Смотрите карточку."
  },
  {
   "from": 4457,
   "to": 4542,
   "text": "Окно — сколько модель видит сразу."
  },
  {
   "from": 4549,
   "to": 4653,
   "text": "Срез знаний: что вышло позже, она не знает."
  },
  {
   "from": 4661,
   "to": 4729,
   "text": "Цена — за миллион токенов."
  },
  {
   "from": 4768,
   "to": 4868,
   "text": "Линейка Claude: Haiku, Sonnet и Opus 5.5."
  },
  {
   "from": 4875,
   "to": 4967,
   "text": "Окно, ответ и срез у всех одинаковые."
  },
  {
   "from": 4974,
   "to": 5046,
   "text": "А цена различается в 40 раз."
  },
  {
   "from": 5054,
   "to": 5128,
   "text": "Разница — в «уме» и скорости."
  },
  {
   "from": 5167,
   "to": 5256,
   "text": "Ошибка — по бренду и флагман на всё."
  },
  {
   "from": 5264,
   "to": 5368,
   "text": "Верно — флагман для плана и сложных ошибок."
  },
  {
   "from": 5375,
   "to": 5456,
   "text": "Средняя модель — на каждый день."
  },
  {
   "from": 5463,
   "to": 5550,
   "text": "Лёгкая — подсказки и простые тесты."
  },
  {
   "from": 5589,
   "to": 5682,
   "text": "Бенчмарк — единый экзамен для моделей."
  },
  {
   "from": 5690,
   "to": 5786,
   "text": "Внизу — анонс: тесты выбирает компания."
  },
  {
   "from": 5793,
   "to": 5899,
   "text": "Выше — независимые замеры в равных условиях."
  },
  {
   "from": 5907,
   "to": 5992,
   "text": "На вершине — ваш мини-набор задач."
  },
  {
   "from": 6031,
   "to": 6133,
   "text": "Мини-набор — 5–10 ваших задач, здесь пять."
  },
  {
   "from": 6140,
   "to": 6210,
   "text": "Пятая — тест проверки веса."
  },
  {
   "from": 6218,
   "to": 6292,
   "text": "У каждой — критерий «готово»."
  },
  {
   "from": 6331,
   "to": 6407,
   "text": "Ошибка — верить цифрам анонса."
  },
  {
   "from": 6415,
   "to": 6510,
   "text": "У лидеров за 90 % тест их не различает."
  },
  {
   "from": 6518,
   "to": 6628,
   "text": "Один и тот же Opus 5.5: 42 на low и 58 на max."
  },
  {
   "from": 6636,
   "to": 6721,
   "text": "Верно — свои задачи и одно усилие."
  },
  {
   "from": 6760,
   "to": 6849,
   "text": "Подписка — как абонемент в спортзал."
  },
  {
   "from": 6857,
   "to": 6931,
   "text": "API — как такси со счётчиком."
  },
  {
   "from": 6970,
   "to": 7078,
   "text": "Лимит: окно в пять часов, поверх — недельный."
  },
  {
   "from": 7086,
   "to": 7177,
   "text": "Чат и Claude Code тратят общий лимит."
  },
  {
   "from": 7185,
   "to": 7263,
   "text": "Остаток покажет команда /usage."
  },
  {
   "from": 7302,
   "to": 7406,
   "text": "Ошибка — сразу API: у счётчика нет потолка."
  },
  {
   "from": 7414,
   "to": 7499,
   "text": "Или сразу Max за $200 — с запасом."
  },
  {
   "from": 7506,
   "to": 7584,
   "text": "Верно — начать с тарифа за $20."
  },
  {
   "from": 7623,
   "to": 7699,
   "text": "Режим выбирают по цене ошибки."
  },
  {
   "from": 7707,
   "to": 7790,
   "text": "ИИ передают намерение и «готово»."
  },
  {
   "from": 7797,
   "to": 7873,
   "text": "Модель — по карточке и задаче."
  },
  {
   "from": 7881,
   "to": 7957,
   "text": "Решает не анонс, а мини-набор."
  },
  {
   "from": 7965,
   "to": 8052,
   "text": "Начните с $20 и следите за лимитом."
  }
 ],
