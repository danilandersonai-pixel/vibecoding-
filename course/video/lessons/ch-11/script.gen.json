 "cues": [
  {
   "from": 9,
   "to": 105,
   "text": "Генерация кода — только начало перемен."
  },
  {
   "from": 112,
   "to": 214,
   "text": "ИИ входит в тесты, сопровождение и дизайн."
  },
  {
   "from": 222,
   "to": 294,
   "text": "Меняются и роли, и сам язык."
  },
  {
   "from": 333,
   "to": 429,
   "text": "Сопровождение — всё, что после выпуска."
  },
  {
   "from": 436,
   "to": 538,
   "text": "Агент пишет тесты по спецификации до кода."
  },
  {
   "from": 546,
   "to": 633,
   "text": "Каждое требование — отдельный тест."
  },
  {
   "from": 640,
   "to": 723,
   "text": "Изменилось — агент обновит тесты."
  },
  {
   "from": 762,
   "to": 860,
   "text": "Просим: тесты из требований, сценарий 3."
  },
  {
   "from": 867,
   "to": 948,
   "text": "Он пишет тесты, а под них — код."
  },
  {
   "from": 955,
   "to": 1042,
   "text": "Запускает их сам: три теста прошли."
  },
  {
   "from": 1050,
   "to": 1135,
   "text": "Ответ: три требования — три теста."
  },
  {
   "from": 1174,
   "to": 1248,
   "text": "Тесты названы по требованиям."
  },
  {
   "from": 1256,
   "to": 1341,
   "text": "Как менялся вес и сколько поднято…"
  },
  {
   "from": 1348,
   "to": 1437,
   "text": "…и строки по неделям: 50, 55, 60 кг."
  },
  {
   "from": 1476,
   "to": 1589,
   "text": "Ошибка — тесты по готовому коду: что он делает."
  },
  {
   "from": 1596,
   "to": 1681,
   "text": "Верно — из требований: что хотели."
  },
  {
   "from": 1720,
   "to": 1828,
   "text": "Инцидент — сбой: приложение работает неверно."
  },
  {
   "from": 1836,
   "to": 1947,
   "text": "Агент собирает журналы, показатели, изменения."
  },
  {
   "from": 1954,
   "to": 2054,
   "text": "Строит гипотезы и предлагает исправление."
  },
  {
   "from": 2061,
   "to": 2168,
   "text": "Решает человек: принять, править, отклонить."
  },
  {
   "from": 2175,
   "to": 2256,
   "text": "И тест — чтобы сбой не вернулся."
  },
  {
   "from": 2295,
   "to": 2384,
   "text": "Пример: падает страница подопечного."
  },
  {
   "from": 2392,
   "to": 2492,
   "text": "Сервер пишет: null там, где ждали список."
  },
  {
   "from": 2499,
   "to": 2577,
   "text": "Ниже — место в коде: строка 82."
  },
  {
   "from": 2616,
   "to": 2718,
   "text": "Агенту — текст ошибки и строка стектрейса."
  },
  {
   "from": 2725,
   "to": 2806,
   "text": "Режим Plan: агент только читает."
  },
  {
   "from": 2814,
   "to": 2905,
   "text": "…и просим: пока ничего не исправлять."
  },
  {
   "from": 2912,
   "to": 2995,
   "text": "Читает файл: причина — в запросе."
  },
  {
   "from": 3034,
   "to": 3123,
   "text": "Выбираем: исправить в самом запросе."
  },
  {
   "from": 3131,
   "to": 3228,
   "text": "Было: нет подходов — запрос отдаёт null."
  },
  {
   "from": 3236,
   "to": 3316,
   "text": "Стало: coalesce — пустой список."
  },
  {
   "from": 3355,
   "to": 3421,
   "text": "Открываем карточку снова…"
  },
  {
   "from": 3429,
   "to": 3516,
   "text": "…на месте: у новой тренировки 0 кг."
  },
  {
   "from": 3555,
   "to": 3657,
   "text": "Ошибка — исправить и на этом остановиться."
  },
  {
   "from": 3664,
   "to": 3732,
   "text": "Верно — тест на этот сбой."
  },
  {
   "from": 3771,
   "to": 3849,
   "text": "Дизайн и разработка сближаются."
  },
  {
   "from": 3857,
   "to": 3944,
   "text": "Эскиз за минуты становится экраном."
  },
  {
   "from": 3951,
   "to": 4034,
   "text": "Дизайн-система — контекст для ИИ."
  },
  {
   "from": 4042,
   "to": 4118,
   "text": "Вариантов много, выбираете вы."
  },
  {
   "from": 4157,
   "to": 4238,
   "text": "Код дешевеет — дорожает ясность."
  },
  {
   "from": 4245,
   "to": 4326,
   "text": "В центре проекта — спецификация."
  },
  {
   "from": 4333,
   "to": 4416,
   "text": "Неясно — вернитесь и уточните её."
  },
  {
   "from": 4455,
   "to": 4557,
   "text": "Наша дизайн-система — файл docs/design.md."
  },
  {
   "from": 4564,
   "to": 4631,
   "text": "Отступы — шаг 4 пикселя."
  },
  {
   "from": 4638,
   "to": 4716,
   "text": "Кнопка — 44 пикселя, под палец."
  },
  {
   "from": 4755,
   "to": 4846,
   "text": "Ошибка — просить «побольше» без меры."
  },
  {
   "from": 4854,
   "to": 4937,
   "text": "Агент угадает, какую и насколько."
  },
  {
   "from": 4976,
   "to": 5087,
   "text": "Та же просьба и «сначала спроси, если неясно»."
  },
  {
   "from": 5094,
   "to": 5166,
   "text": "Агент читает docs/design.md…"
  },
  {
   "from": 5174,
   "to": 5256,
   "text": "…и спрашивает: какую и насколько."
  },
  {
   "from": 5295,
   "to": 5380,
   "text": "Отвечаем: все кнопки — 44 пикселя."
  },
  {
   "from": 5387,
   "to": 5453,
   "text": "Агент правит файл стилей."
  },
  {
   "from": 5461,
   "to": 5539,
   "text": "Одно правило — для всех кнопок."
  },
  {
   "from": 5578,
   "to": 5674,
   "text": "Было: ни токена, ни правила для кнопок."
  },
  {
   "from": 5681,
   "to": 5764,
   "text": "Стало: токен — высота 44 пикселя…"
  },
  {
   "from": 5771,
   "to": 5856,
   "text": "…и правило: кнопка не ниже токена."
  },
  {
   "from": 5895,
   "to": 5995,
   "text": "Разработчик всё реже автор каждой строки."
  },
  {
   "from": 6002,
   "to": 6096,
   "text": "Он редактор, постановщик, оркестратор."
  },
  {
   "from": 6103,
   "to": 6182,
   "text": "Основа — отвечать за результат."
  },
  {
   "from": 6221,
   "to": 6323,
   "text": "Обычная речь — новый язык высокого уровня."
  },
  {
   "from": 6330,
   "to": 6415,
   "text": "Мы описываем, что нужно, а не как."
  },
  {
   "from": 6423,
   "to": 6512,
   "text": "Остаются спецификации, тесты и типы."
  },
  {
   "from": 6520,
   "to": 6594,
   "text": "Код читают реже — как чертёж."
  },
  {
   "from": 6633,
   "to": 6724,
   "text": "Вайб-кодинг открыл разработку многим."
  },
  {
   "from": 6732,
   "to": 6812,
   "text": "Но много кода никто не проверял."
  },
  {
   "from": 6851,
   "to": 6936,
   "text": "Пример — последние коммиты недели."
  },
  {
   "from": 6943,
   "to": 7030,
   "text": "Задача агенту, его ветка и слияние."
  },
  {
   "from": 7038,
   "to": 7125,
   "text": "Мы ставили задачи и проверяли итог."
  },
  {
   "from": 7164,
   "to": 7266,
   "text": "Ошибка — видеть силу в скорости генерации."
  },
  {
   "from": 7273,
   "to": 7369,
   "text": "Верно — понимать, проверять и отвечать."
  },
  {
   "from": 7377,
   "to": 7443,
   "text": "Этому и учила эта книга."
  },
  {
   "from": 7482,
   "to": 7550,
   "text": "Тесты пишут из требований."
  },
  {
   "from": 7557,
   "to": 7651,
   "text": "Разбор сбоя готовит агент, решаете вы."
  },
  {
   "from": 7658,
   "to": 7741,
   "text": "Дизайн-система — контекст для ИИ."
  },
  {
   "from": 7748,
   "to": 7850,
   "text": "Основа роли — понимание и ответственность."
  },
  {
   "from": 7858,
   "to": 7951,
   "text": "Агентам — проверяемое, себе — решения."
  }
 ],
 "hotspots": [
  {
   "from": 436,
