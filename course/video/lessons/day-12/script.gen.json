 "cues": [
  {
   "from": 9,
   "to": 94,
   "text": "Ссылка-приглашение для подопечных."
  },
  {
   "from": 101,
   "to": 199,
   "text": "Ссылка — новая дверь, её надо проверить."
  },
  {
   "from": 207,
   "to": 285,
   "text": "И аудит агентом — только отчёт."
  },
  {
   "from": 324,
   "to": 398,
   "text": "Просим приглашение по ссылке."
  },
  {
   "from": 406,
   "to": 493,
   "text": "Агент пишет страницу и регистрацию."
  },
  {
   "from": 500,
   "to": 585,
   "text": "И ссылку — на страницу подопечных."
  },
  {
   "from": 593,
   "to": 682,
   "text": "По ссылке человек станет подопечным."
  },
  {
   "from": 721,
   "to": 812,
   "text": "Марина открывает страницу подопечных."
  },
  {
   "from": 820,
   "to": 915,
   "text": "Внизу — ссылка, в конце адреса — её id."
  },
  {
   "from": 954,
   "to": 1037,
   "text": "Ольга открывает ссылку от Марины."
  },
  {
   "from": 1044,
   "to": 1133,
   "text": "Имя, почта, пароль — она в дневнике."
  },
  {
   "from": 1172,
   "to": 1268,
   "text": "Но ссылку переслали — её открыл Кирилл."
  },
  {
   "from": 1275,
   "to": 1347,
   "text": "Присоединился — и он внутри."
  },
  {
   "from": 1386,
   "to": 1494,
   "text": "Смотрим в базе, кто теперь подопечный Марины."
  },
  {
   "from": 1502,
   "to": 1580,
   "text": "Ольга — и Кирилл, его не звали."
  },
  {
   "from": 1619,
   "to": 1719,
   "text": "Тренер — из адреса, а адрес пришёл извне."
  },
  {
   "from": 1726,
   "to": 1824,
   "text": "Вызвать может любой, у кого есть ссылка."
  },
  {
   "from": 1832,
   "to": 1908,
   "text": "Сколько угодно раз, без срока."
  },
  {
   "from": 1947,
   "to": 2034,
   "text": "Теперь о безопасности просим прямо."
  },
  {
   "from": 2041,
   "to": 2139,
   "text": "Одноразово, со сроком — и сначала тесты."
  },
  {
   "from": 2147,
   "to": 2221,
   "text": "Агент пишет тесты и миграцию."
  },
  {
   "from": 2228,
   "to": 2320,
   "text": "Перед psql и удалением — вопрос, «y»."
  },
  {
   "from": 2327,
   "to": 2416,
   "text": "Новая страница, регистрация, кнопки."
  },
  {
   "from": 2424,
   "to": 2509,
   "text": "Перед тестами — «y». Шесть прошли."
  },
  {
   "from": 2516,
   "to": 2605,
   "text": "Прошлых регистраций агент не трогал."
  },
  {
   "from": 2644,
   "to": 2746,
   "text": "Было: тренер из адреса. Стало — из записи."
  },
  {
   "from": 2753,
   "to": 2843,
   "text": "Код — 16 случайных байт: не угадать."
  },
  {
   "from": 2850,
   "to": 2920,
   "text": "Срок — 48 часов с создания."
  },
  {
   "from": 2928,
   "to": 3000,
   "text": "Кто принял и когда отозвано."
  },
  {
   "from": 3039,
   "to": 3152,
   "text": "Ольга и Кирилл здесь: дверь закрыта на будущее."
  },
  {
   "from": 3159,
   "to": 3246,
   "text": "Марина создаёт приглашение с кодом."
  },
  {
   "from": 3285,
   "to": 3374,
   "text": "По новой ссылке регистрируется Вера."
  },
  {
   "from": 3382,
   "to": 3462,
   "text": "Присоединилась — она в дневнике."
  },
  {
   "from": 3501,
   "to": 3579,
   "text": "Открываем ту же ссылку ещё раз."
  },
  {
   "from": 3587,
   "to": 3665,
   "text": "«Уже использовано» — формы нет."
  },
  {
   "from": 3704,
   "to": 3812,
   "text": "Новая дверь — новая проверка: шесть вопросов."
  },
  {
   "from": 3820,
   "to": 3946,
   "text": "Откуда данные, кто вправе, что сделает злоумышленник?"
  },
  {
   "from": 3953,
   "to": 4040,
   "text": "Журналы, права и правки вне задачи."
  },
  {
   "from": 4079,
   "to": 4192,
   "text": "Просим агента пройти по шести вопросам главы 8."
  },
  {
   "from": 4199,
   "to": 4308,
   "text": "Код не менять: только отчёт и места сомнений."
  },
  {
   "from": 4315,
   "to": 4396,
   "text": "Режим Plan: агент только читает."
  },
  {
   "from": 4403,
   "to": 4505,
   "text": "Лимита попыток нет — и сомнение про почту."
  },
  {
   "from": 4544,
   "to": 4640,
   "text": "Почту проверяем здесь — до приглашения."
  },
  {
   "from": 4647,
   "to": 4743,
   "text": "По ответу видно, занята ли чужая почта."
  },
  {
   "from": 4750,
   "to": 4839,
   "text": "Подтвердились: это следующие задачи."
  },
  {
   "from": 4878,
   "to": 4974,
   "text": "Ссылка на раз и срок — решение примера."
  },
  {
   "from": 4981,
   "to": 5064,
   "text": "Срок не ждите — проверьте тестом."
  },
  {
   "from": 5071,
   "to": 5173,
   "text": "Аудит по шести вопросам — без правок кода."
  },
  {
   "from": 5181,
   "to": 5248,
   "text": "Находки — повод проверить."
  }
 ],
