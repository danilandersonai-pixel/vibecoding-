  },
  {
   "from": 3963,
   "to": 4048,
   "text": "Пустой status — всё как в коммите."
  },
  {
   "from": 4087,
   "to": 4178,
   "text": "Окружение разработки — ваш компьютер."
  },
  {
   "from": 4186,
   "to": 4260,
   "text": "Staging — копия для проверки."
  },
  {
   "from": 4267,
   "to": 4339,
   "text": "Продакшен — для живых людей."
  },
  {
   "from": 4378,
   "to": 4463,
   "text": "npm run dev — сайт работает у вас."
  },
  {
   "from": 4470,
   "to": 4555,
   "text": "Открыли localhost — пришёл запрос."
  },
  {
   "from": 4594,
