 "cues": [
  {
   "from": 9,
   "to": 79,
   "text": "Из чего состоит приложение."
  },
  {
   "from": 86,
   "to": 152,
   "text": "Как Git хранит историю."
  },
  {
   "from": 160,
   "to": 226,
   "text": "Как код попадает на сайт."
  },
  {
   "from": 233,
   "to": 308,
   "text": "Как понять, что всё работает."
  },
  {
   "from": 315,
   "to": 381,
   "text": "И слова про ИИ."
  },
  {
   "from": 420,
   "to": 513,
   "text": "Почти любое приложение — как ресторан."
  },
  {
   "from": 521,
   "to": 627,
   "text": "Зал — фронтенд: всё, что видно и нажимается."
  },
  {
   "from": 635,
   "to": 730,
   "text": "Официант — API: правила общения частей."
  },
  {
   "from": 738,
   "to": 823,
   "text": "Кухня — бэкенд: логика на сервере."
  },
  {
   "from": 830,
   "to": 909,
   "text": "Склад — база данных, хранилище."
  },
  {
   "from": 948,
   "to": 1037,
   "text": "В редакторе — все файлы: это проект."
  },
  {
   "from": 1045,
   "to": 1134,
   "text": "Фронтенд — page.tsx: поле «Повторы»…"
  },
  {
   "from": 1141,
   "to": 1215,
   "text": "…и кнопка «Сохранить подход»."
  },
  {
   "from": 1254,
   "to": 1337,
   "text": "Официант и кухня — файл route.ts."
  },
  {
   "from": 1344,
   "to": 1433,
   "text": "По адресу /api/sets приходит подход."
  },
  {
   "from": 1441,
   "to": 1515,
   "text": "Кухня проверяет: вес — число?"
  },
  {
   "from": 1523,
   "to": 1589,
   "text": "Нет — ответ с кодом 400."
  },
  {
   "from": 1628,
   "to": 1721,
   "text": "Список чужих деталей — в package.json."
  },
  {
   "from": 1729,
   "to": 1818,
   "text": "Без зависимостей проект не работает."
  },
  {
   "from": 1826,
   "to": 1904,
   "text": "Next.js и React — каркас сайта."
  },
  {
   "from": 1943,
   "to": 2026,
   "text": "Ошибка — вставить ключ API в чат."
  },
  {
   "from": 2065,
   "to": 2148,
   "text": "Верно — ключ хранят в .env.local."
  },
  {
   "from": 2187,
   "to": 2287,
   "text": "Git этот файл не хранит: он в .gitignore."
  },
  {
   "from": 2294,
   "to": 2379,
   "text": "Значит, на GitHub ключ не попадёт."
  },
  {
   "from": 2418,
   "to": 2496,
   "text": "Git помнит всю историю проекта."
  },
  {
   "from": 2504,
   "to": 2597,
   "text": "Как сохранения в игре: точка — коммит."
  },
  {
   "from": 2605,
   "to": 2694,
   "text": "Ветка — копия для безопасных опытов."
  },
  {
   "from": 2702,
   "to": 2786,
   "text": "Пул-реквест — просьба влить ветку."
  },
  {
   "from": 2794,
   "to": 2870,
   "text": "Не вышло — откат к сохранению."
  },
  {
   "from": 2909,
   "to": 2996,
   "text": "Терминал — окно для команд текстом."
  },
  {
   "from": 3003,
   "to": 3101,
   "text": "git init: папка становится репозиторием."
  },
  {
   "from": 3109,
   "to": 3194,
   "text": "git status: Git за ними не следит."
  },
  {
   "from": 3201,
   "to": 3279,
   "text": "Коммит — сохранение с подписью."
  },
  {
   "from": 3318,
   "to": 3407,
   "text": "В основной ветке main — три коммита."
  },
  {
   "from": 3415,
   "to": 3497,
   "text": "Форма — коммит в ветке sets-form."
  },
  {
   "from": 3505,
   "to": 3583,
   "text": "git merge вливает ветку в main."
  },
  {
   "from": 3622,
   "to": 3711,
   "text": "Ошибка — крупная правка без коммита."
  },
  {
   "from": 3719,
   "to": 3806,
   "text": "Дифф: ИИ переписал 48 строк стилей."
  },
  {
   "from": 3813,
   "to": 3915,
   "text": "Верно — с коммитом её отменит git restore."
  },
  {
   "from": 3923,
   "to": 4007,
   "text": "Пустой status — всё как в коммите."
  },
  {
   "from": 4046,
   "to": 4112,
   "text": "Окружений обычно три."
  },
  {
   "from": 4120,
   "to": 4189,
   "text": "Разработка — ваш компьютер."
  },
  {
   "from": 4197,
   "to": 4284,
   "text": "Staging — копия, где всё проверяют."
  },
  {
   "from": 4291,
   "to": 4363,
   "text": "Продакшен — для живых людей."
  },
  {
   "from": 4402,
   "to": 4478,
   "text": "Сайт сначала запускают у себя."
  },
  {
   "from": 4486,
   "to": 4586,
   "text": "npm run dev — сайт работает на localhost."
  },
  {
   "from": 4593,
   "to": 4682,
   "text": "Открыли — dev-сервер записал запрос."
  },
  {
   "from": 4721,
   "to": 4804,
   "text": "Ошибка — проверить только у себя."
  },
  {
   "from": 4811,
   "to": 4888,
   "text": "Верно — staging, потом деплой."
  },
  {
   "from": 4927,
   "to": 4993,
   "text": "Баг — ошибка в программе."
  },
  {
   "from": 5001,
   "to": 5079,
   "text": "Тест — автоматическая проверка."
  },
  {
   "from": 5086,
   "to": 5171,
   "text": "F12 открывает панель разработчика."
  },
  {
   "from": 5210,
   "to": 5288,
   "text": "Вводим вес «60 кг» и сохраняем."
  },
  {
   "from": 5296,
   "to": 5381,
   "text": "На странице — ничего. Где причина?"
  },
  {
   "from": 5388,
   "to": 5475,
   "text": "Console: красная строка, ответ 400."
  },
  {
   "from": 5514,
   "to": 5607,
   "text": "Пишем агенту, что делали: вес «60 кг»."
  },
  {
   "from": 5615,
   "to": 5715,
   "text": "Что ждали: подход в списке или подсказку."
  },
  {
   "from": 5722,
   "to": 5820,
   "text": "Что вышло — и сам текст ошибки, целиком."
  },
  {
   "from": 5828,
   "to": 5906,
   "text": "Агент нашёл причину и поправил."
  },
  {
   "from": 5945,
   "to": 6026,
   "text": "Ошибка — «не работает, исправь»."
  },
  {
   "from": 6033,
   "to": 6122,
   "text": "Верно — ошибка целиком и что делали."
  },
  {
   "from": 6161,
   "to": 6252,
   "text": "Модель — сам ИИ: Claude, GPT, Gemini."
  },
  {
   "from": 6260,
   "to": 6334,
   "text": "Промпт — ваш запрос к модели."
  },
  {
   "from": 6341,
   "to": 6431,
   "text": "Контекст — всё, что ИИ сейчас видит."
  },
  {
   "from": 6438,
   "to": 6546,
   "text": "Токены — кусочки текста: по ним считают цену."
  },
  {
   "from": 6554,
   "to": 6643,
   "text": "MCP подключает к агенту инструменты."
  },
  {
   "from": 6682,
   "to": 6775,
   "text": "Агент не просто отвечает, а действует."
  },
  {
   "from": 6783,
   "to": 6864,
   "text": "Просим форму «Сохранить подход»."
  },
  {
   "from": 6871,
   "to": 6962,
   "text": "Reading — агент читает файл страницы."
  },
  {
   "from": 6970,
   "to": 7037,
   "text": "Edited — правит три файла."
  },
  {
   "from": 7045,
   "to": 7111,
   "text": "И отвечает, что сделал."
  },
  {
   "from": 7150,
   "to": 7239,
   "text": "Ошибка — сразу запустить команду ИИ."
  },
  {
   "from": 7247,
   "to": 7329,
   "text": "npm отвечает: такого скрипта нет."
  },
  {
   "from": 7337,
   "to": 7439,
   "text": "Галлюцинация: ИИ уверенно выдумал команду."
  },
  {
   "from": 7446,
   "to": 7531,
   "text": "Верно — проверить список: npm run."
  },
  {
   "from": 7570,
   "to": 7648,
   "text": "Четыре части — как в ресторане."
  },
  {
   "from": 7656,
   "to": 7734,
   "text": "Ключи — в .env.local, не в чат."
  },
  {
   "from": 7742,
   "to": 7820,
   "text": "Перед крупной правкой — коммит."
  },
  {
   "from": 7828,
   "to": 7904,
   "text": "Сначала у себя, потом staging."
  },
  {
   "from": 7912,
   "to": 7988,
   "text": "Ошибку отправляйте ИИ целиком."
  },
  {
   "from": 7995,
   "to": 8063,
   "text": "А команды ИИ — проверяйте."
