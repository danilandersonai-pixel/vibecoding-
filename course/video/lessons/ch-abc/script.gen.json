 "cues": [
  {
   "from": 9,
   "to": 96,
   "text": "Из каких частей состоит приложение."
  },
  {
   "from": 103,
   "to": 182,
   "text": "Как Git хранит историю проекта."
  },
  {
   "from": 189,
   "to": 255,
   "text": "Как код попадает на сайт."
  },
  {
   "from": 263,
   "to": 348,
   "text": "Как ловить ошибки. И слова про ИИ."
  },
  {
   "from": 387,
   "to": 480,
   "text": "Почти любое приложение — как ресторан."
  },
  {
   "from": 488,
   "to": 594,
   "text": "Зал — фронтенд: всё, что видно и нажимается."
  },
  {
   "from": 602,
   "to": 697,
   "text": "Официант — API: правила общения частей."
  },
  {
   "from": 705,
   "to": 794,
   "text": "Кухня — бэкенд: проверки на сервере."
  },
  {
   "from": 801,
   "to": 880,
   "text": "Склад — база данных, хранилище."
  },
  {
   "from": 919,
   "to": 1012,
   "text": "Слева в редакторе — все файлы: проект."
  },
  {
   "from": 1020,
   "to": 1107,
   "text": "Фронтенд — файл app/page.tsx: поля…"
  },
  {
   "from": 1114,
   "to": 1189,
   "text": "…и кнопка «Сохранить подход»."
  },
  {
   "from": 1228,
   "to": 1311,
   "text": "Официант и кухня — файл route.ts."
  },
  {
   "from": 1318,
   "to": 1407,
   "text": "По адресу /api/sets приходит подход."
  },
  {
   "from": 1415,
   "to": 1489,
   "text": "Кухня проверяет: вес — число?"
  },
  {
   "from": 1497,
   "to": 1563,
   "text": "Нет — ответ с кодом 400."
  },
  {
   "from": 1602,
   "to": 1678,
   "text": "Чужие детали — в package.json."
  },
  {
   "from": 1686,
   "to": 1788,
   "text": "Зависимости: без них проект не заработает."
  },
  {
   "from": 1795,
   "to": 1874,
   "text": "Next.js и React — каркас сайта."
  },
  {
   "from": 1913,
   "to": 2006,
   "text": "Ошибка — вставить ключ API в чат с ИИ."
  },
  {
   "from": 2014,
   "to": 2116,
   "text": "Ключ API — пароль. Его место — .env.local."
  },
  {
   "from": 2123,
   "to": 2210,
   "text": "git status пуст: Git ключ не видит."
  },
  {
   "from": 2249,
   "to": 2327,
   "text": "Git помнит всю историю проекта."
  },
  {
   "from": 2335,
   "to": 2428,
   "text": "Как сохранения в игре: точка — коммит."
  },
  {
   "from": 2436,
   "to": 2525,
   "text": "Ветка — копия для безопасных опытов."
  },
  {
   "from": 2533,
   "to": 2617,
   "text": "Пул-реквест — просьба влить ветку."
  },
  {
   "from": 2625,
   "to": 2701,
   "text": "Не вышло — откат к сохранению."
  },
  {
   "from": 2740,
   "to": 2827,
   "text": "Терминал — окно для команд текстом."
  },
  {
   "from": 2834,
   "to": 2932,
   "text": "git init: папка становится репозиторием."
  },
  {
   "from": 2940,
   "to": 3042,
   "text": "git status: новые файлы, Git их не хранит."
  },
  {
   "from": 3049,
   "to": 3128,
   "text": "Коммит — сохранение с подписью."
  },
  {
   "from": 3167,
   "to": 3250,
   "text": "Дифф — разница двух версий файла."
  },
  {
   "from": 3257,
   "to": 3340,
   "text": "Красное убрали, зелёное добавили."
  },
  {
   "from": 3379,
   "to": 3468,
   "text": "В основной ветке main — три коммита."
  },
  {
   "from": 3476,
   "to": 3558,
   "text": "Форма — коммит в ветке sets-form."
  },
  {
   "from": 3566,
   "to": 3644,
   "text": "git merge вливает ветку в main."
  },
  {
   "from": 3683,
   "to": 3772,
   "text": "Ошибка — крупная правка без коммита."
  },
  {
   "from": 3780,
   "to": 3882,
   "text": "Верно — сначала коммит. Тогда git restore…"
  },
  {
   "from": 3889,
   "to": 3961,
   "text": "…вернёт файл, как в коммите."
  },
  {
   "from": 4000,
   "to": 4102,
   "text": "Окружений три. Разработка — ваш компьютер."
  },
  {
   "from": 4109,
   "to": 4197,
   "text": "Staging — копия, где всё проверяют."
  },
  {
   "from": 4204,
   "to": 4276,
   "text": "Продакшен — для живых людей."
  },
  {
   "from": 4315,
   "to": 4402,
   "text": "Запускаем сайт у себя: npm run dev."
  },
  {
   "from": 4409,
   "to": 4497,
   "text": "Ready — сайт работает на localhost."
  },
  {
   "from": 4504,
   "to": 4593,
   "text": "Открыли его — сервер записал запрос."
  },
  {
   "from": 4632,
   "to": 4715,
   "text": "Ошибка — проверить только у себя."
  },
  {
   "from": 4722,
   "to": 4799,
   "text": "Верно — staging, потом деплой."
  },
  {
   "from": 4838,
   "to": 4904,
   "text": "Баг — ошибка в программе."
  },
  {
   "from": 4912,
   "to": 4990,
   "text": "Тест — автоматическая проверка."
  },
  {
   "from": 4997,
   "to": 5082,
   "text": "F12 открывает панель разработчика."
  },
  {
   "from": 5121,
   "to": 5199,
   "text": "Вводим вес «60 кг» и сохраняем."
  },
  {
   "from": 5207,
   "to": 5292,
   "text": "На странице — ничего. Где причина?"
  },
  {
   "from": 5299,
   "to": 5395,
   "text": "На вкладке Console красная строка: 400."
  },
  {
   "from": 5434,
   "to": 5527,
   "text": "Пишем агенту, что делали: вес «60 кг»."
  },
  {
   "from": 5535,
   "to": 5616,
   "text": "Что ждали: подход или подсказку."
  },
  {
   "from": 5623,
   "to": 5710,
   "text": "Что вышло — и текст ошибки целиком."
  },
  {
   "from": 5718,
   "to": 5796,
   "text": "Агент нашёл причину и поправил."
  },
  {
   "from": 5835,
   "to": 5922,
   "text": "Снова «60 кг» и «Сохранить подход»."
  },
  {
   "from": 5929,
   "to": 6014,
   "text": "Под формой подсказка: вес — число."
  },
  {
   "from": 6053,
   "to": 6134,
   "text": "Ошибка — «не работает, исправь»."
  },
  {
   "from": 6141,
   "to": 6230,
   "text": "Верно — ошибка целиком и что делали."
  },
  {
   "from": 6269,
   "to": 6360,
   "text": "Модель — сам ИИ: Claude, GPT, Gemini."
  },
  {
   "from": 6368,
   "to": 6442,
   "text": "Промпт — ваш запрос к модели."
  },
  {
   "from": 6449,
   "to": 6539,
   "text": "Контекст — всё, что ИИ сейчас видит."
  },
  {
   "from": 6546,
   "to": 6635,
   "text": "Токены — кусочки текста: в них цена."
  },
  {
   "from": 6643,
   "to": 6732,
   "text": "MCP подключает к агенту инструменты."
  },
  {
   "from": 6771,
   "to": 6864,
   "text": "Агент не только отвечает, а действует."
  },
  {
   "from": 6872,
   "to": 6953,
   "text": "Просим форму «Сохранить подход»."
  },
  {
   "from": 6960,
   "to": 7051,
   "text": "Reading — агент читает файл страницы."
  },
  {
   "from": 7059,
   "to": 7126,
   "text": "Edited — правит три файла."
  },
  {
   "from": 7134,
   "to": 7200,
   "text": "И отвечает, что сделал."
  },
  {
   "from": 7239,
   "to": 7330,
   "text": "Ошибка — поверить выдуманной команде."
  },
  {
   "from": 7338,
   "to": 7421,
   "text": "npm отвечает: такого скрипта нет."
  },
  {
   "from": 7428,
   "to": 7513,
   "text": "Галлюцинация: ИИ уверенно выдумал."
  },
  {
   "from": 7520,
   "to": 7605,
   "text": "Верно — проверить список: npm run."
  },
  {
   "from": 7644,
   "to": 7722,
   "text": "Четыре части — как в ресторане."
  },
  {
   "from": 7730,
   "to": 7808,
   "text": "Перед крупной правкой — коммит."
  },
  {
   "from": 7816,
   "to": 7892,
   "text": "Сначала у себя, потом staging."
  },
  {
   "from": 7900,
   "to": 7976,
   "text": "Ошибку отправляйте ИИ целиком."
  },
  {
   "from": 7983,
   "to": 8051,
   "text": "А команды ИИ — проверяйте."
  }
 ],
